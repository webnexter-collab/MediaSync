# --- MediaSync environment ---

# Neon Postgres connection string (pooled). Use a NEW, separate Neon database
# for MediaSync — do not point it at the BizDocs database.
DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/mediasync?sslmode=require"

# Long random string used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string"
